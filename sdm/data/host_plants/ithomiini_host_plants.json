{
  "_metadata": {
    "description": "Ithomiini butterfly host plant associations compiled from published literature",
    "sources": [
      "Willmott & Freitas (2006) - Higher-level phylogeny of the Ithomiinae, Cladistics 22:1-74",
      "Drummond & Brown (1987) - Host plants of Neotropical Ithomiinae (first comprehensive catalog)",
      "Brown & Freitas (1994) - Juvenile stages of Ithomiinae (Lepidoptera: Nymphalidae)",
      "Beccaloni et al. (2008) - Catalogue of hostplants of Neotropical butterflies",
      "Silva-Brandão et al. (2005, 2012, 2017) - Solanaceae-Ithomiini coevolution studies",
      "Hay-Roe & Nation (2007) - Spectrum of cyanogenesis in Ithomiinae",
      "NHM HOSTS database (https://www.nhm.ac.uk/our-science/data/hostplants/)"
    ],
    "notes": [
      "Most Ithomiini feed on Solanaceae; basal lineages (Tithoreini) feed on Apocynaceae",
      "Where species-level data is lacking, genus-level host associations are used",
      "confidence: 'high' = published species-level record, 'medium' = genus-level inference, 'low' = family-level inference"
    ]
  },
